# Planora AI Configuration
PORT=5000

# Optional PostgreSQL / Supabase connection URL
# e.g.: postgresql://postgres:password@localhost:5432/planora_db
# If left blank, the application automatically uses high-performance persistent local JSON storage!
DATABASE_URL=

# Optional AI LLM API Keys
# Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=
# or OpenAI API Key:
OPENAI_API_KEY=

# Authentication secret
JWT_SECRET=planora_super_secret_jwt_key_2026
