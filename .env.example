# ===================================================
# EventPilot Environment Variables & Deployment Guide
# ===================================================

# 1. AI Engine (Optional - Defaults to Intelligent Deterministic Engine if blank)
# Obtain a free Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=

# Alternatively, OpenAI API key can be supplied:
OPENAI_API_KEY=

# 2. Database Connection (Optional - Defaults to Local/Ephemeral Storage if blank)
# Supports Supabase, Neon, Vercel Postgres, Railway, or standard PostgreSQL.
# Example for Supabase (Session Pooler or Direct):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example for Neon:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3. Security & Authentication Secret
# A strong random secret key for JWT session tokens:
JWT_SECRET=eventpilot_prod_secure_secret_jwt_key_2026

# 4. CORS Origins (Optional)
# By default, EventPilot automatically permits all *.vercel.app domains and localhost.
# Set this only if you use a custom domain (e.g. https://eventpilot.yourdomain.com):
CORS_ORIGIN=

# 5. Port (For standalone local server only, Vercel handles this automatically)
PORT=5000
